      <column name="LESSON_ID" type="UUID"><constraints nullable="false"/></column>
      <column name="LESSON_VERSION_ID" type="UUID"><constraints nullable="false"/></column>
      <column name="STARTED_AT" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="COMPLETED_AT" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>
  </changeSet>
  <changeSet id="6" author="ui-capture">
    <addForeignKeyConstraint baseTableName="UIC_STUDY_GROUP" baseColumnNames="OWNER_ID" constraintName="FK_STUDY_GROUP_OWNER_ID" referencedTableName="UIC_USER" referencedColumnNames="ID"/>
    <createIndex tableName="UIC_STUDY_GROUP" indexName="IDX_UIC_STUDY_GROUP_OWNER"><column name="OWNER_ID"/></createIndex>
  </changeSet>
