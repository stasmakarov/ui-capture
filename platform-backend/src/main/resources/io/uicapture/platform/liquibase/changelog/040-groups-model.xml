    <addForeignKeyConstraint baseTableName="UIC_GROUP_COURSE_PROGRESS" baseColumnNames="COURSE_ID" constraintName="FK_GCP_COURSE_ID" referencedTableName="UIC_COURSE" referencedColumnNames="ID"/>
