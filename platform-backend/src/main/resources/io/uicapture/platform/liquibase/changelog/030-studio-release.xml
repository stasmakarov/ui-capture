<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">
    <changeSet id="1" author="ui-capture">
        <createTable tableName="UIC_STUDIO_RELEASE">
            <column name="ID" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="VERSION" type="INT"><constraints nullable="false"/></column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="VERSION_NAME" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="PLATFORM_" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="FILE_NAME" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="SHA512" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="SIZE_" type="BIGINT"><constraints nullable="false"/></column>
            <column name="EXE" type="VARCHAR(1024)"><constraints nullable="false"/></column>
            <column name="LATEST_YML" type="VARCHAR(1024)"><constraints nullable="false"/></column>
            <column name="UPLOADED_AT" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="UPLOADED_BY" type="VARCHAR(255)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="ui-capture">
        <addUniqueConstraint tableName="UIC_STUDIO_RELEASE" columnNames="PLATFORM_" constraintName="IDX_UIC_STUDIO_RELEASE_PLATFORM"/>
    </changeSet>
    <changeSet id="3" author="ui-capture">
        <addColumn tableName="UIC_USER">
            <column name="STUDIO_LOCAL_PORT" type="INT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
