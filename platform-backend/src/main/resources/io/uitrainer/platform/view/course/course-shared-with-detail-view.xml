<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://courseSharedWithDetailView.title"
      focusComponent="form">
    <data>
        <instance id="courseSharedWithDc" class="io.uitrainer.platform.entity.CourseSharedWith">
            <fetchPlan extends="_base">
                <property name="course" fetchPlan="_instance_name"/>
                <property name="trainer" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="courseSharedWithDl"/>
        </instance>
        <collection id="trainersDc" class="io.uitrainer.platform.entity.User">
            <fetchPlan extends="_instance_name">
                <property name="username"/>
                <property name="firstName"/>
                <property name="lastName"/>
            </fetchPlan>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="courseSharedWithDc">
            <entityComboBox id="trainerField" property="trainer" itemsContainer="trainersDc"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
