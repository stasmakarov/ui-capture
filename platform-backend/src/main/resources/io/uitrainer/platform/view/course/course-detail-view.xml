<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://courseDetailView.title"
      focusComponent="form">
    <data>
        <instance id="courseDc"
                  class="io.uitrainer.platform.entity.Course">
            <fetchPlan extends="_base">
                <property name="lessons" fetchPlan="_base">
                    <property name="currentVersion" fetchPlan="_instance_name"/>
                </property>
                <property name="owner" fetchPlan="_instance_name"/>
                <property name="coauthors" fetchPlan="_base">
                    <property name="trainer" fetchPlan="_instance_name"/>
                </property>
                <property name="sharedWith" fetchPlan="_base">
                    <property name="trainer" fetchPlan="_instance_name"/>
                </property>
            </fetchPlan>
            <loader id="courseDl"/>
            <collection id="lessonsDc" property="lessons"/>
            <collection id="coauthorsDc" property="coauthors"/>
            <collection id="sharedWithDc" property="sharedWith"/>
        </instance>
        <collection id="usersDc" class="io.uitrainer.platform.entity.User">
            <fetchPlan extends="_instance_name">
                <property name="username"/>
                <property name="firstName"/>
                <property name="lastName"/>
            </fetchPlan>
            <loader id="usersDl">
                <query>
                    <![CDATA[select u from User u order by u.username]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="courseDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="titleField" property="title"/>
            <textField id="codeField" property="code"/>
            <textArea id="descriptionField" height="9.5em" property="description"/>
            <entityComboBox id="ownerField" property="owner" itemsContainer="usersDc"/>
            <radioButtonGroup id="sharingField" property="sharing" dataContainer="courseDc" colspan="2"/>
        </formLayout>
        <h4 id="authorsTitle" text="msg://authors"/>
        <hbox id="coauthorsButtonsPanel" classNames="buttons-panel">
            <button id="createCoauthorButton" action="coauthorsDataGrid.createAction"/>
            <button id="removeCoauthorButton" action="coauthorsDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="coauthorsDataGrid" dataContainer="coauthorsDc" width="100%" minHeight="8em">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="trainer"/>
            </columns>
        </dataGrid>
        <hbox id="sharedWithButtonsPanel" classNames="buttons-panel">
            <button id="createSharedButton" action="sharedWithDataGrid.createAction"/>
            <button id="removeSharedButton" action="sharedWithDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="sharedWithDataGrid" dataContainer="sharedWithDc" width="100%" minHeight="8em">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="trainer"/>
            </columns>
        </dataGrid>
        <h4 text="msg://io.uitrainer.platform.entity/Course.lessons"/>
        <hbox id="lessonsButtonsPanel" classNames="buttons-panel">
            <button id="recordInStudio" text="msg://recordInStudio" icon="CIRCLE" themeNames="primary"/>
            <button id="recordInStudioLocal" text="msg://recordInStudioLocal" themeNames="tertiary"/>
            <button action="lessonsDataGrid.createAction"/>
            <button action="lessonsDataGrid.editAction"/>
            <button action="lessonsDataGrid.removeAction"/>
            <button id="moveUpButton" text="msg://io.uitrainer.platform.view.group/moveUp"/>
            <button id="moveDownButton" text="msg://io.uitrainer.platform.view.group/moveDown"/>
        </hbox>
        <dataGrid id="lessonsDataGrid" dataContainer="lessonsDc" width="100%" minHeight="20em">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                        <property name="viewId" value="uic_Lesson.edit"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                        <property name="viewId" value="uic_Lesson.edit"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="sortOrder"/>
                <column property="title"/>
                <column property="externalId"/>
                <column property="sourceSite"/>
                <column property="status"/>
                <column property="currentVersion"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
