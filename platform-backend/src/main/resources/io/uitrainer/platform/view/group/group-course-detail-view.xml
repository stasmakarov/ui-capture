<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://groupCourseDetailView.title"
      focusComponent="form">
    <data>
        <instance id="groupCourseDc" class="io.uitrainer.platform.entity.GroupCourse">
            <fetchPlan extends="_base">
                <property name="group" fetchPlan="_base">
                    <property name="owner" fetchPlan="_instance_name"/>
                </property>
                <property name="course" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="groupCourseDl"/>
        </instance>
        <collection id="ownerCoursesDc" class="io.uitrainer.platform.entity.Course">
            <fetchPlan extends="_base"/>
            <loader id="ownerCoursesDl">
                <query>
                    <![CDATA[select c from uic_Course c order by c.title]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="groupCourseDc">
            <entityComboBox id="courseField" property="course" itemsContainer="ownerCoursesDc"/>
            <integerField id="sortOrderField" property="sortOrder"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
