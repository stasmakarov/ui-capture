# Скопировать на сервер как /etc/uitrainer/app.env (chmod 600, chown root:uitrainer).
# НЕ коммитить реальный app.env.

# Профиль dev/local НЕ включать на сервере.
# SPRING_PROFILES_ACTIVE=   # оставить пустым или не задавать

UITRAINER_DB_URL=jdbc:postgresql://localhost:5432/uitrainer?stringtype=unspecified
UITRAINER_DB_USER=uitrainer
UITRAINER_DB_PASSWORD=<password>

UITRAINER_FILES_DIR=/var/lib/uitrainer/files
UITRAINER_PUBLIC_URL=http://<SERVER_IP>:8090

PORT=8090

# Без HTTPS cookie Secure ломает сессию в браузере:
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
