{
  "name": "uitrainer",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "bin": {
    "uitrainer": "./bin/uitrainer.js"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "lesson-schema",
    "player",
    "studio",
    "student-portal",
    "desktop"
  ],
  "scripts": {
    "start": "tsx tools/cli.ts studio",
    "dev": "vite --host 127.0.0.1 --port 43127 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 43127 --strictPort",
    "test": "vitest run",
    "capture": "tsx tools/cli.ts",
    "capture:scenario": "tsx tools/capture/run.ts",
    "build:lessons": "tsx tools/builder/run.ts",
    "pipeline": "tsx tools/capture/run.ts && tsx tools/builder/run.ts",
    "build:template": "node tools/pack/buildTemplate.mjs",
    "build:inpage": "node tools/capture/buildInpage.mjs",
    "pack:html": "tsx tools/pack/singlefile.ts",
    "schema": "tsx lesson-schema/scripts/generate-schema.ts"
  },
  "dependencies": {
    "@fontsource/pt-sans": "^5.3.0",
    "@xenova/transformers": "^2.17.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrweb-snapshot": "^2.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
